ahorules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }

    match /events/{eventId}/public/images/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 15 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
      allow delete: if isAdmin();
    } 
    match /events/{eventId}/public/audio/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 25 * 1024 * 1024 && request.resource.contentType.matches('audio/.*');
      allow delete: if isAdmin();
    }
    match /events/{eventId}/public/video/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size < 150 * 1024 * 1024 && request.resource.contentType.matches('video/.*');
      allow delete: if isAdmin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
